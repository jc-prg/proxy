#---------------------------------------------
# jc://proxy/ configuration
# copy to .env, edit and run ./create
# (read by ./create and by docker compose - keep it dotenv compatible: no "export", no arrays, comments on their own lines)
#---------------------------------------------

# GENERAL INSTRUCTIONS: How to add a domain
# ............................................
# - create (sub-)domain @ your providers admin page
# - set domain to DynDNS @ your providers admin page
# - set DynDNS to your routers IP address, e.g. using set-dns
# - add as proxy domain and letsencrypt_domain above, create new configration
# - run cert creation and restart proxy


# PROXY CONFIGURATION
# ............................................
# Domain configuration, one entry per line: "host[/folder];forward[;snippet]"
#   host/folder - route https://host/folder/... to http://forward/... (prefix is stripped)
#   snippet     - optional, from config/templates/snippets/ (root entries only)
PROXY_DOMAINS="
sub-domain-1.example.com;192.168.1.20:81
sub-domain-1.example.com/folder;192.168.1.50:81
sub-domain-2.example.com;192.168.1.20:80;nextcloud
"

# Proxy configuration
PROXY_DIR="/projects/prod/proxy"
PROXY_DIR_DATA="${PROXY_DIR}/config"

# domain.conf / domain-no-ssl.conf
PROXY_TEMP="domain.conf"


# SSL CONFIGURATION
# ............................................
# list your domains, separated with comma
LETSENCRYPT_DOMAINS="sub-domain-1.example.com,sub-domain-2.example.com"
# set your mail to request a letsencrypt certificate
LETSENCRYPT_EMAIL="your-email@example.com"
# set if dry run (yes/no)
LETSENCRYPT_DRYRUN="yes"

# Letsencrypt directories
LETSENCRYPT_HTML="${PROXY_DIR_DATA}/html"
LETSENCRYPT_SSL="${PROXY_DIR_DATA}/letsencrypt"


# NGINX CONFIGURATION
# ............................................
# NGINX - official multi-arch image (amd64, arm64, arm/v7)
NGINX_IMAGE="nginx:stable-alpine"
NGINX_CONFIG="${PROXY_DIR_DATA}/nginx/nginx.conf"
NGINX_DOMAINS="${PROXY_DIR_DATA}/nginx-domains"
NGINX_CONTAINER="proxy"

# System - docker compose v2 plugin
DOCKER_COMPOSE="docker compose"
