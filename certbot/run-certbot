#!/bin/sh

echo "Certbot Renew Certificates ..."
echo
echo "Host(s): $LETSENCRYPT_HOST"
echo "E-mail:  $LETSENCRYPT_MAIL"
echo "Dry Run: $LETSENCRYPT_DRYRUN"
echo

dryrun=""
if [ "$LETSENCRYPT_DRYRUN" = "yes" ]; then
  dryrun="--dry-run"
fi

for domain in $(echo "$LETSENCRYPT_HOST" | tr ',' ' ')
do
  echo
  echo "Create certificate for $domain ..."
  echo

  certbot certonly --standalone -d "$domain" --non-interactive --email "$LETSENCRYPT_MAIL" --agree-tos --no-eff-email --keep-until-expiring $dryrun

done

echo "Done."
