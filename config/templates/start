#!/bin/bash
#--------------------------------------------------
# ${THIS_IS_THE_PROJECT_TEMPLATE}
#--------------------------------------------------

dir="${PROXY_DIR}"
docker_compose="${DOCKER_COMPOSE}"
renewal_name="start_letsencrypt.info"

echo
echo "-------------------------------------"
echo "Start jc://proxy/"
echo "(by Christoph Kloth)"
echo "-------------------------------------"
if [ -f "${D}dir/${D}renewal_name" ]; then
    echo "Info: last letsencrypt renewal"
    cat "${D}dir/${D}renewal_name"
else
    echo "Info: no letsencrypt renewal documented yet"
fi
echo
echo


start_proxy() {
	${D}docker_compose -f "${D}dir/docker-compose.yml" up -d
	}

stop_proxy() {
	${D}docker_compose -f "${D}dir/docker-compose.yml" stop
	}

update_images() {
	${D}docker_compose -f "${D}dir/docker-compose.yml" pull
	${D}docker_compose -f "${D}dir/docker-compose-certbot.yml" build --pull
	}

renew_cert() {
	update_images
	stop_proxy
	${D}docker_compose -f "${D}dir/docker-compose-certbot.yml" up --abort-on-container-exit
	${D}docker_compose -f "${D}dir/docker-compose-certbot.yml" down
	date > "${D}dir/${D}renewal_name"
	start_proxy
	}

usage() {
	echo "Usage: ${D}0 [start|stop|renew]"
	}


config="${D}1"

if [ -z "${D}config" ]; then
  echo "Press key - your options:"
  echo
  echo " 'q' - exit"
  echo " 's' - start proxy"
  echo " 'x' - stop proxy"
  echo " 'z' - letsencrypt: check/renew certificates"
  echo

  count=0
  while : ; do
    read -n 1 k <&1
    if [[ ${D}k = q ]] ; then
       printf "\nQuitting from the program.\n"
       exit 0
    elif [[ ${D}k = s ]] ; then
       start_proxy
       break
    elif [[ ${D}k = x ]] ; then
       stop_proxy
       break
    elif [[ ${D}k = z ]] ; then
       renew_cert
       break
    else
       ((count=${D}count+1))
       printf "\nIterate for ${D}count times\n"
       echo "Press 'q' to exit"
    fi
  done
else
  if [[ ${D}config = "start" ]] ; then
     start_proxy
  elif [[ ${D}config = "stop" ]] ; then
     stop_proxy
  elif [[ ${D}config = "renew" ]] ; then
     renew_cert
  else
     usage
     exit 1
  fi
fi


echo
echo "Done."
