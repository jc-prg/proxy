#!/usr/bin/env bash
#--------------------------
# usage: ./create   (reads .env)

set -eu

cd "$(dirname "$0")"

config=".env"

echo
echo "-------------------------------------"
echo " Create jc://proxy/ configuration"
echo " (by Christoph Kloth)"
echo "-------------------------------------"

if ! [ -f "$config" ]; then
  echo
  echo "ERROR: No config file '$config' available! Copy '.env.sample' to '.env', edit and run this script again."
  echo
  exit 1
fi

printf "\nCreating from %s ...\n" "$config"

# export all variables of the config file for envsubst
set -a
# shellcheck source=/dev/null
source "./$config"
set +a

: "${PROXY_DIR:?missing in $config}" "${NGINX_DOMAINS:?missing in $config}" "${LETSENCRYPT_SSL:?missing in $config}" "${PROXY_TEMP:?missing in $config}" "${PROXY_DOMAINS:?missing in $config}"

# escaped "$" for the nginx templates
export D="$"

mkdir -p "$LETSENCRYPT_SSL" "$NGINX_DOMAINS"

cp config/templates/00-default.conf "$NGINX_DOMAINS/00-default.conf"

# collect location blocks per host ("host[/folder];forward[;snippet]")
declare -A LOCATIONS=() HAS_ROOT=() SEEN=()
hosts=()

while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"      # trim leading whitespace
    line="${line%"${line##*[![:space:]]}"}"      # trim trailing whitespace
    [[ -z "$line" || "$line" == \#* ]] && continue

    IFS=";" read -r target forward snippet_name <<< "$line"

    host="${target%%/*}"
    path=""
    if [[ "$target" == */* ]]; then
      path="/${target#*/}"
      path="${path%/}"
    fi

    if [ -z "$host" ] || [ -z "${forward:-}" ]; then
      echo "ERROR: invalid entry '$line' (expected 'host[/folder];forward[;snippet]')."
      exit 1
    fi

    # values are written into the nginx config: allow plain names only (no spaces, ';', '{', quotes, ...)
    invalid=""
    if ! [[ "$host" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]]; then
      invalid="host '$host' (letters, digits, '.', '-')"
    elif [ -n "$path" ] && { ! [[ "$path" =~ ^(/[A-Za-z0-9._~-]+)+$ ]] || [[ "$path" =~ /\.\.?(/|$) ]]; }; then
      invalid="folder '$path' (letters, digits, '.', '_', '~', '-', '/', no '.' or '..' segments)"
    elif ! [[ "$forward" =~ ^[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$ ]]; then
      invalid="forward '$forward' (expected 'address[:port][/path]' without 'http://')"
    elif [ -n "${snippet_name:-}" ] && ! [[ "$snippet_name" =~ ^[A-Za-z0-9_-]+$ ]]; then
      invalid="snippet '$snippet_name' (letters, digits, '_', '-')"
    fi
    if [ -n "$invalid" ]; then
      echo "ERROR: invalid $invalid in entry '$line'."
      exit 1
    fi

    if [ -n "${SEEN[$host$path/]:-}" ]; then
      echo "ERROR: duplicate entry for '$host${path:-/}'."
      exit 1
    fi
    SEEN[$host$path/]=1

    if [ -z "${LOCATIONS[$host]+x}" ]; then
      hosts+=("$host")
      LOCATIONS[$host]=""
    fi

    # forward "address[:port][/path]" - split for the snippets (regex locations need a plain proxy_pass)
    forward="${forward%/}"
    export SERVER_NAME="$host"
    export FORWARD_HOST="${forward%%/*}"
    export FORWARD_PATH=""
    [[ "$forward" == */* ]] && FORWARD_PATH="/${forward#*/}"
    export LOCATION_PATH="$path"
    export LOCATION_REGEX="${path//./\\.}"

    # optional 3rd field: snippet from config/templates/snippets/ (e.g. "nextcloud")
    if [ -n "${snippet_name:-}" ]; then
      snippet="config/templates/snippets/${snippet_name}.conf"
      if ! [ -f "$snippet" ]; then
        echo "ERROR: snippet '$snippet' for $host not found."
        exit 1
      fi
      LOCATIONS[$host]+="$(envsubst < "$snippet")"$'\n\n'
    fi

    if [ -z "$path" ]; then
      # without a path the request uri is passed unchanged, with a path "/" is replaced by "/path/"
      export SERVER_FORWARD="$forward"
      [ -n "$FORWARD_PATH" ] && SERVER_FORWARD="$forward/"
      LOCATIONS[$host]+="$(envsubst < config/templates/location-root.conf)"$'\n\n'
      HAS_ROOT[$host]=1
    else
      export SERVER_FORWARD="$forward"
      LOCATIONS[$host]+="$(envsubst < config/templates/location-folder.conf)"$'\n\n'
    fi
done <<< "$PROXY_DOMAINS"

for host in "${hosts[@]}"; do
    export SERVER_NAME="$host"
    SERVER_LOCATIONS="${LOCATIONS[$host]}"

    # only subfolders defined: nothing to serve on /
    if [ -z "${HAS_ROOT[$host]:-}" ]; then
      SERVER_LOCATIONS+="    location /                {"$'\n'"                                return        404;"$'\n'"                                }"$'\n\n'
    fi
    export SERVER_LOCATIONS="${SERVER_LOCATIONS%$'\n\n'}"$'\n'

    rm -f "$NGINX_DOMAINS/$host.conf"
    envsubst < "config/templates/$PROXY_TEMP" > "$NGINX_DOMAINS/$host.conf"
    echo " $host"
done

echo
echo "Done."
echo
