#!/usr/bin/env bash
#--------------------------------------------------
# usage: ./start [start|stop|renew|dryrun]
#--------------------------------------------------

dir="$(cd "$(dirname "$0")" && pwd)"
renewal_name="start_letsencrypt.info"
config="$1"

echo
echo "-------------------------------------"
echo "Start jc://proxy/"
echo "(by Christoph Kloth)"
echo "-------------------------------------"
if [ -f "$dir/$renewal_name" ]; then
    echo "Info: last letsencrypt renewal"
    cat "$dir/$renewal_name"
else
    echo "Info: no letsencrypt renewal documented yet"
fi
echo


load_env() {
	# shellcheck source=/dev/null
	source "$dir/.env"
	docker_compose="${DOCKER_COMPOSE:-docker compose}"
	}

create_config() {
	nano "$dir/.env"
	if ! bash "$dir/create"; then
	  echo "ERROR: creating the configuration failed - fix .env and try again."
	  return 1
	fi
	load_env
	}

check_certs() {
	# nginx does not start if a certificate of a domain config is missing - check in a temporary
	# proxy container (same mounts as nginx, letsencrypt/live is readable for root only)
	local missing
	missing_domains=()
	missing="$($docker_compose -f "$dir/docker-compose.yml" run --rm --no-deps -T --entrypoint sh proxy -c '
		for cert in $(sed -n "s/^[[:space:]]*ssl_certificate[[:space:]]\{1,\}\([^;\$]*\);.*/\1/p" /etc/nginx/conf.d/*.conf | sort -u); do
		  [ -f "$cert" ] || echo "$cert"
		done' </dev/null)" || { echo "ERROR: could not check the certificates."; return 1; }
	[ -z "$missing" ] && return 0

	echo
	echo "ERROR: missing certificates - the proxy would not start:"
	for cert in $missing; do
	  missing_domains+=("$(basename "$(dirname "$cert")")")
	  echo "  ${missing_domains[-1]}  ($cert)"
	done
	echo
	echo "Hint: domains you no longer need: remove them from PROXY_DOMAINS and run ./create"
	echo "      (or delete your own config in NGINX_DOMAINS)."
	echo
	return 1
	}

ensure_certs() {
	# check the certificates, offer to create missing ones (interactive only, not after a renewal)
	check_certs && return 0
	[ -n "${no_cert_prompt:-}" ] && return 1
	if ! [ -t 0 ]; then
	  echo "Create the certificates with '$0 renew'."
	  return 1
	fi

	# certbot requests the domains of LETSENCRYPT_DOMAINS only (and renews them weekly)
	local domain not_listed=()
	for domain in "${missing_domains[@]}"; do
	  [[ ",${LETSENCRYPT_DOMAINS// /}," == *",$domain,"* ]] || not_listed+=("$domain")
	done
	if [ ${#not_listed[@]} -gt 0 ]; then
	  echo "Not in LETSENCRYPT_DOMAINS: ${not_listed[*]}"
	  echo "Add them in .env (menu 'c'), then create the certificates with '$0 renew' (menu 'z')."
	  return 1
	fi

	printf "Create the certificates now (the proxy is stopped meanwhile)? [y/n] "
	read -r -n 1 k
	echo
	if [[ $k != [yYjJ] ]] ; then
	  echo "Cancelled."
	  return 1
	fi
	request_certs
	check_certs
	}

restart_proxy() {
	ensure_certs || { echo "Proxy not restarted."; return 1; }
	# check the new configuration in the running proxy first - keep it running if invalid
	if [ -n "$($docker_compose -f "$dir/docker-compose.yml" ps -q --status running proxy)" ]; then
	  if ! $docker_compose -f "$dir/docker-compose.yml" exec -T proxy nginx -t; then
	    echo "ERROR: new configuration is invalid - proxy keeps running with the old one."
	    return 1
	  fi
	fi
	stop_proxy
	start_proxy
	}

start_proxy() {
	ensure_certs || { echo "Proxy not started."; return 1; }
	$docker_compose -f "$dir/docker-compose.yml" up -d
	}

stop_proxy() {
	$docker_compose -f "$dir/docker-compose.yml" stop
	}

update_images() {
	$docker_compose -f "$dir/docker-compose.yml" pull
	$docker_compose -f "$dir/docker-compose-certbot.yml" build --pull
	}

request_certs() {
	update_images
	stop_proxy
	$docker_compose -f "$dir/docker-compose-certbot.yml" up --abort-on-container-exit
	$docker_compose -f "$dir/docker-compose-certbot.yml" down
	date > "$dir/$renewal_name"
	}

renew_cert() {
	request_certs
	no_cert_prompt=1 start_proxy
	}

dryrun_cert() {
	$docker_compose -f "$dir/docker-compose-certbot.yml" build --pull
	stop_proxy
	$docker_compose -f "$dir/docker-compose-certbot.yml" run --rm --service-ports -e LETSENCRYPT_DRYRUN=yes certbot
	$docker_compose -f "$dir/docker-compose-certbot.yml" down
	no_cert_prompt=1 start_proxy
	}

usage() {
	echo "Usage: $0 [start|stop|renew|dryrun]"
	}


if ! [ -f "$dir/.env" ]; then
  # only ask in an interactive call without arguments (never in cron)
  if [ -n "$config" ] || ! [ -t 0 ]; then
    echo "ERROR: No config file '$dir/.env' available! Run $0 without arguments to create one."
    exit 1
  fi
  printf "No configuration (.env) found. Create one from .env.sample? [y/n] "
  read -r -n 1 k
  echo
  if [[ $k != [yYjJ] ]] ; then
    echo "Quitting from the program."
    exit 0
  fi
  cp "$dir/.env.sample" "$dir/.env"
  chmod 600 "$dir/.env"
  create_config || exit 1
  echo
fi

load_env

if [ -z "$config" ]; then
  echo "Press key - your options:"
  echo
  echo " 'q' - exit"
  echo " 'c' - create configuration (edit .env, then ./create)"
  echo " 's' - start proxy"
  echo " 'x' - stop proxy"
  echo " 'z' - letsencrypt: check/renew certificates"
  echo " 'd' - letsencrypt: dry run (test renewal, no changes)"
  echo

  count=0
  while : ; do
    read -n 1 k <&1
    if [[ $k = q ]] ; then
       printf "\nQuitting from the program.\n"
       exit 0
    elif [[ $k = c ]] ; then
       echo
       if create_config ; then
         printf "Restart the proxy now to apply the new configuration? [y/n] "
         read -r -n 1 k
         echo
         if [[ $k = [yYjJ] ]] ; then
           restart_proxy
         else
           echo "Not restarted - apply later with 'x' (stop) and 's' (start)."
         fi
       fi
       break
    elif [[ $k = s ]] ; then
       start_proxy
       break
    elif [[ $k = x ]] ; then
       stop_proxy
       break
    elif [[ $k = z ]] ; then
       renew_cert
       break
    elif [[ $k = d ]] ; then
       dryrun_cert
       break
    else
       ((count=$count+1))
       printf "\nIterate for $count times\n"
       echo "Press 'q' to exit"
    fi
  done
else
  if [[ $config = "start" ]] ; then
     start_proxy || exit 1
  elif [[ $config = "stop" ]] ; then
     stop_proxy
  elif [[ $config = "renew" ]] ; then
     renew_cert
  elif [[ $config = "dryrun" ]] ; then
     dryrun_cert
  else
     usage
     exit 1
  fi
fi


echo
echo "Done."
